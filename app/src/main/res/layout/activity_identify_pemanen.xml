<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootIdentifyPemanen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.view.faceRecognition.IdentifyPemanenActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/instructionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cbi.mobile_plantation.ui.view.faceRecognition.FaceAlignmentGuideOverlay
        android:id="@+id/faceGuideOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.cbi.mobile_plantation.ui.view.faceRecognition.FaceBoundingBoxOverlay
        android:id="@+id/faceOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <LinearLayout
        android:id="@+id/cameraControlsTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white_background"
            android:clickable="true"
            android:contentDescription="@string/al_back"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tvEnrolledCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_label_background"
            android:fontFamily="@font/manrope_semibold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/black"
            android:textSize="@dimen/s"
            tools:text="Wajah terdaftar: 0" />

        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white_background"
            android:clickable="true"
            android:contentDescription="@string/ganti_kamera"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/baseline_cameraswitch_24"
            app:tint="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cameraControlsSide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cameraControlsTop">

        <ImageView
            android:id="@+id/btnPanenDate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_white_background"
            android:clickable="true"
            android:contentDescription="@string/pilih_tanggal_panen"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/baseline_calendar_month_24"
            app:tint="@color/black" />

        <ImageView
            android:id="@+id/btnThresholdSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_white_background"
            android:clickable="true"
            android:contentDescription="@string/atur_threshold_wajah"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/baseline_tune_24"
            app:tint="@color/black" />

        <ImageView
            android:id="@+id/btnEnrollFace"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_white_background"
            android:clickable="true"
            android:contentDescription="@string/daftar_wajah_pemanen"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/baseline_add_a_photo_24"
            app:tint="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/instructionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/actionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/previewView">

        <TextView
            android:id="@+id/tvEnrollStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:textColor="@color/greenBorder"
            android:textSize="@dimen/s"
            android:visibility="gone"
            tools:text="Langkah 2 dari 3"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope_semibold"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/identify_pemanen_instruction"
            android:textColor="@color/white"
            android:textSize="@dimen/m" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIdentify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/greenBorder"
            android:fontFamily="@font/manrope_bold"
            android:minHeight="52dp"
            android:text="@string/identifikasi_sekarang"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/baseline_camera_front_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
